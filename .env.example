# Port Configuration
PORT=3000

# Authentication (optional)
# If set, requires password to access the app
# If not set, authentication is disabled
ADMIN_PASSWORD=

# Database
# Relative paths resolve from the process CWD. Default keeps backward
# compatibility with installs that never set this variable.
DATABASE_PATH=./data/app.db

# App URL for Emails
BASE_URL=http://localhost:3000

# Scheduler (optional)
# Set ENABLE_SCHEDULER=0 to disable cron jobs (useful for local dev / some environments).
ENABLE_SCHEDULER=1
# IANA timezone name used by node-cron (default: UTC)
SCHEDULER_TIMEZONE=UTC

# Note: SMTP Settings are configured via UI and stored in Database

# ─────────────────────────────────────────────────────────────────────────────
# Web Push (v1.2)
# Generate keys with:  npx web-push generate-vapid-keys --json
# Leave blank to disable push notifications.
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Port Configuration
PORT=3000

# Authentication
# Set a strong password for normal deployments. Authentication is disabled
# only when AUTH_DISABLED=true is set explicitly.
ADMIN_PASSWORD=123456
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Optional stable key for encrypting stored notification secrets.
# Defaults to SESSION_SECRET or ADMIN_PASSWORD when unset.
SECRET_ENCRYPTION_KEY=
# AUTH_DISABLED=true
# TRUST_PROXY_HEADERS=true

# Database
# Relative paths resolve from the process CWD. Default keeps backward
# compatibility with installs that never set this variable.
DATABASE_PATH=./data/app.db

# App URL for Emails
BASE_URL=http://localhost:3000

# Scheduler (optional)
# Set ENABLE_SCHEDULER=0 to disable cron jobs (useful for local dev / some environments).
ENABLE_SCHEDULER=1
# IANA timezone name used by the built-in scheduler (default: UTC)
SCHEDULER_TIMEZONE=UTC

# Note: SMTP Settings are configured via UI and stored in Database

# ─────────────────────────────────────────────────────────────────────────────
# Web Push (v1.2)
# Generate keys with:  npx web-push generate-vapid-keys --json
# Leave blank to disable push notifications.
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Port Configuration
PORT=3000

# Stable key for encrypting stored notification secrets.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# TRUST_PROXY_HEADERS=true

# Webhook delivery only allows public http/https targets by default.
# Set true only when you intentionally deliver to trusted LAN/private endpoints.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Database
# Relative paths resolve from the process CWD.
DATABASE_PATH=./data/app.db

# App URL for emails and notification links.
BASE_URL=http://localhost:3000

# Scheduler (optional)
# Set ENABLE_SCHEDULER=0 or false to disable cron jobs.
ENABLE_SCHEDULER=1
# IANA timezone name used by the built-in scheduler (default: UTC).
SCHEDULER_TIMEZONE=UTC

# SMTP settings are configured via the UI and stored in the database.

# Web Push
# Generate keys with: npx web-push generate-vapid-keys --json
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

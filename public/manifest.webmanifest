{
  "name": "DomBeacon",
  "short_name": "DomBeacon",
  "description": "Self-hosted domain ops beacon for tracking opportunities, managing portfolios, and monitoring expiration/SSL risks",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EDF5F3",
  "theme_color": "#0E6B6F",
  "lang": "zh-CN",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Domains",
      "url": "/domains",
      "description": "Open domain list"
    },
    {
      "name": "Action Queue",
      "url": "/actions",
      "description": "Pending actions"
    },
    {
      "name": "Notifications",
      "url": "/notifications",
      "description": "Notification history"
    }
  ]
}
